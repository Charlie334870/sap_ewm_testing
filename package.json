{
  "name": "sap-ewm-automation",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AI SAP EWM engineering and support agent platform",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @ewm/api --filter @ewm/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "db:generate": "pnpm --filter @ewm/database generate",
    "db:migrate": "pnpm --filter @ewm/database migrate"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@ewm/sap-tools": "workspace:*",
    "@types/node": "^22.0.0",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
