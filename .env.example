# Copy this file to .env and change the values marked CHANGE ME.
# Never commit .env and never paste its contents into a chat.

# --- Database -------------------------------------------------------------
POSTGRES_USER=ewm
# CHANGE ME. Letters and digits only (no @ : / # or spaces): it becomes part of an address.
POSTGRES_PASSWORD=changeMeDbPassword123
POSTGRES_DB=ewm
# Used when running the API outside Docker (pnpm dev) and by the tests.
# Keep the password in these two lines the same as POSTGRES_PASSWORD above.
DATABASE_URL=postgres://ewm:changeMeDbPassword123@localhost:5433/ewm
DATABASE_URL_TEST=postgres://ewm:changeMeDbPassword123@localhost:5433/ewm_test

# --- First administrator (created once, when the database has no users) ----
BOOTSTRAP_ORG_NAME=My Consulting Company
# CHANGE ME: your email address. You sign in with it.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_NAME=Administrator
# CHANGE ME: at least 12 characters. You can change it later inside the console.
BOOTSTRAP_ADMIN_PASSWORD=change-me-now-please

# --- Web / API ---------------------------------------------------------------
WEB_ORIGIN=http://localhost:3000
API_PORT=4000
# Where the web console finds the API when both run outside Docker (pnpm dev).
API_INTERNAL_URL=http://localhost:4000
# Set to true only when the site is served over HTTPS.
COOKIE_SECURE=false
LOG_LEVEL=info
